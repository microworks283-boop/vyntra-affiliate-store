# Copy this file to .env and enter your SMTP settings. Never commit .env.
# Gmail: create a Google App Password (requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
FROM_EMAIL=your-email@gmail.com
PORT=4000
